{
  "name": "whisper-web",
  "version": "0.0.29",
  "private": true,
  "description": "An end-to-end encrypted LAN device collaboration app with quick send, QR pairing, resumable transfers, and media previews.",
  "keywords": [
    "file transfer",
    "lan sharing",
    "local network",
    "offline transfer",
    "p2p",
    "end-to-end encryption",
    "qr pairing",
    "system quick send",
    "media preview",
    "chat transfer",
    "text sharing",
    "whisper",
    "局域网文件传输",
    "本地共享",
    "离线传输",
    "聊天传文件"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "pages:build": "npm run build && node scripts/prepare-pages-output.mjs",
    "start": "node scripts/preview-static.mjs",
    "lint": "eslint .",
    "test:release-assets": "node scripts/check-release-asset-matching.mjs",
    "test:pages": "node --test scripts/pages-routing.test.mjs",
    "test:seo": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.14.4",
    "lenis": "1.3.26",
    "next": "15.5.25",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "zustand": "^5.0.2",
    "next-themes": "^0.4.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
