{
  "name": "whisper-web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "A local network file and text transfer software using a chat-like interface. Easily share files and messages across devices on your LAN without needing an internet connection.",
  "keywords": [
    "file transfer",
    "lan sharing",
    "local network",
    "offline transfer",
    "p2p",
    "chat transfer",
    "text sharing",
    "whisper",
    "局域网文件传输",
    "本地共享",
    "离线传输",
    "聊天传文件"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "check": "npm run audit:prod && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "1.24.0",
    "next": "15.5.20",
    "next-themes": "0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/eslintrc": "3.3.5",
    "@playwright/test": "1.61.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.20",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "3.2.7"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}
